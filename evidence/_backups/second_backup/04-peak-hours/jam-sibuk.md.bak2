```sql hourly_by_day
SELECT
  CAST(order_hour AS VARCHAR) || ':00' AS order_hour_label,
  order_hour,
  CASE dayofweek(order_date)
    WHEN 0 THEN 'Minggu'
    WHEN 1 THEN 'Senin'
    WHEN 2 THEN 'Selasa'
    WHEN 3 THEN 'Rabu'
    WHEN 4 THEN 'Kamis'
    WHEN 5 THEN 'Jumat'
    WHEN 6 THEN 'Sabtu'
  END AS nama_hari,
  SUM(total_orders) AS total_orders
FROM restaurant.peak_hours
WHERE order_date >= (SELECT MAX(order_date) FROM restaurant.peak_hours) - INTERVAL '29 days'
AND ('${inputs.cabang || 'Semua Cabang'}' = 'Semua Cabang' OR branch_name = '${inputs.cabang || 'Semua Cabang'}')
AND ('${inputs.hari || 'Semua Hari'}' = 'Semua Hari' OR 
    CASE dayofweek(order_date)
      WHEN 0 THEN 'Minggu'
      WHEN 1 THEN 'Senin'
      WHEN 2 THEN 'Selasa'
      WHEN 3 THEN 'Rabu'
      WHEN 4 THEN 'Kamis'
      WHEN 5 THEN 'Jumat'
      WHEN 6 THEN 'Sabtu'
    END = '${inputs.hari || 'Semua Hari'}'
)
GROUP BY 1, 2
ORDER BY order_hour ASC
```

