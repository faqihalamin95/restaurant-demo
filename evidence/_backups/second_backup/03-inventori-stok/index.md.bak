```sql inv_trend_7d
SELECT
    txn_date,
    category,
    ROUND(AVG(avg_unit_cost), 0) AS avg_harga
FROM restaurant.inventory_stok
WHERE txn_date >= (SELECT MAX(txn_date) FROM restaurant.inventory_stok) - INTERVAL '6 days'
GROUP BY txn_date, category
ORDER BY txn_date
```

```sql inv_trend_30d
SELECT
    txn_date,
    category,
    ROUND(AVG(avg_unit_cost), 0) AS avg_harga
FROM restaurant.inventory_stok
WHERE txn_date >= (SELECT MAX(txn_date) FROM restaurant.inventory_stok) - INTERVAL '29 days'
GROUP BY txn_date, category
ORDER BY txn_date
```

```sql inv_latest_reorder
WITH max_d AS (SELECT MAX(txn_date)::DATE AS d FROM restaurant.inventory_stok),
movement AS (
    SELECT
        branch_name,
        item_name,
        ROUND(SUM(usage_qty)/30.0,2) AS avg_daily_usage,
        SUM(usage_cost) AS usage_cost_30d
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date >= d - INTERVAL '29 days'
    GROUP BY 1, 2
),
latest AS (
    SELECT *
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date = d
)
SELECT
    l.branch_name,
    l.item_name,
    l.category,
    l.unit,
    l.stock_on_hand,
    l.days_remaining,
    l.stock_value,
    COALESCE(m.avg_daily_usage,0) AS avg_daily_usage,
    COALESCE(m.usage_cost_30d,0) AS usage_cost_30d,
    CASE
        WHEN l.days_remaining < 1.5 THEN '🚨 Kritis (Hari Ini)'
        WHEN l.days_remaining < 3 THEN '⚠️ Reorder Sekarang'
        ELSE '📋 Pantau'
    END AS reorder_status
FROM latest l
LEFT JOIN movement m ON l.branch_name = m.branch_name AND l.item_name = m.item_name
WHERE l.stock_status = 'low' OR l.days_remaining <= 5
ORDER BY l.days_remaining ASC, m.usage_cost_30d DESC
```

```sql inv_latest_overstock
WITH max_d AS (SELECT MAX(txn_date)::DATE AS d FROM restaurant.inventory_stok),
movement AS (
    SELECT
        branch_name,
        item_name,
        SUM(usage_cost) AS usage_cost_30d,
        SUM(purchase_cost) AS purchase_cost_30d,
        ROUND(SUM(purchase_cost)/NULLIF(SUM(usage_cost),0),2) AS purchase_usage_ratio_30d
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date >= d - INTERVAL '29 days'
    GROUP BY 1, 2
),
latest AS (
    SELECT *
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date = d
)
SELECT
    l.branch_name,
    l.item_name,
    l.category,
    l.unit,
    l.stock_on_hand,
    l.days_remaining,
    l.stock_value,
    ROUND(l.stock_value * GREATEST(l.days_remaining - 14, 0) / NULLIF(l.days_remaining,0),0) AS estimated_idle_value,
    ROUND(GREATEST(l.days_remaining - 14, 0),1) AS days_to_normal,
    COALESCE(m.purchase_usage_ratio_30d,0) AS purchase_usage_ratio_30d,
    CASE
        WHEN l.days_remaining >= 30 THEN 'Sangat Berlebih'
        WHEN l.days_remaining >= 21 THEN 'Berlebih Tinggi'
        ELSE 'Berlebih'
    END AS overstock_status,
    CASE
        WHEN l.days_remaining >= 30 THEN 'Tahan PO dan cari transfer/push menu'
        WHEN l.days_remaining >= 21 THEN 'Tahan pembelian sampai coverage turun'
        ELSE 'Pantau jadwal pembelian berikutnya'
    END AS recommended_action
FROM latest l
LEFT JOIN movement m ON l.branch_name = m.branch_name AND l.item_name = m.item_name
WHERE l.stock_status = 'overstock' OR l.days_remaining > 14
ORDER BY estimated_idle_value DESC, l.days_remaining DESC
```

```sql inv_latest_transfers
WITH low AS (
    SELECT *
    FROM ${inv_latest_reorder}
    WHERE days_remaining < 3
),
over AS (
    SELECT *
    FROM ${inv_latest_overstock}
    WHERE days_remaining > 14
)
SELECT
    low.item_name,
    low.category,
    low.branch_name AS branch_need,
    low.days_remaining AS need_days,
    over.branch_name AS branch_source,
    over.days_remaining AS source_days,
    over.stock_on_hand AS source_stock,
    over.stock_value AS source_stock_value
FROM low
JOIN over ON low.item_name = over.item_name AND low.branch_name <> over.branch_name
ORDER BY low.days_remaining ASC, over.stock_value DESC
```

```sql inv_latest_reorder_agg
WITH max_d AS (SELECT MAX(txn_date)::DATE AS d FROM restaurant.inventory_stok),
latest AS (
    SELECT *
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date = d
)
SELECT
    COUNT(CASE WHEN days_remaining < 3 THEN 1 END) AS critical_reorder_count,
    COUNT(*) AS total_low_stock_items
FROM latest
WHERE stock_status = 'low' OR days_remaining <= 5
```

```sql inv_latest_overstock_agg
WITH max_d AS (SELECT MAX(txn_date)::DATE AS d FROM restaurant.inventory_stok),
latest AS (
    SELECT *
    FROM restaurant.inventory_stok CROSS JOIN max_d
    WHERE txn_date = d
),
overstock_details AS (
    SELECT
        l.stock_value,
        l.days_remaining,
        ROUND(l.stock_value * GREATEST(l.days_remaining - 14, 0) / NULLIF(l.days_remaining,0),0) AS estimated_idle_value
    FROM latest l
    WHERE l.stock_status = 'overstock' OR l.days_remaining > 14
)
SELECT
    COUNT(*) AS total_overstock_items,
    ROUND(COALESCE(SUM(estimated_idle_value), 0), 0) AS total_idle_value
FROM overstock_details
```

_Dashboard control center: kesehatan stok aktual, modal kerja, disiplin pembelian, dan tekanan harga supplier._

<details class="context-acc">
<summary>📋 Cara memilih subpage</summary>
<div class="acc-body">
<ul>
  <li><strong>Ringkasan</strong> — baca status cepat dari Food Cost, rasio belanja, dan akar masalah operasional.</li>
  <li><strong>Stok Aktual</strong> — kelola item rawan habis (Reorder) dan barang menumpuk (Overstock) secara langsung.</li>
  <li><strong>Cabang</strong> — bandingkan kedisiplinan pengadaan dan ketimpangan posisi stok antar outlet.</li>
  <li><strong>Analisis Lanjutan</strong> — audit volatilitas harga bahan dan renegosiasi kontrak supplier.</li>
</ul>
Total pengeluaran dan profitabilitas tetap paling pas dibaca di halaman <a class="inline-link" href="/01-laporan-keuangan">Laporan Keuangan</a>.
</div>
</details>

{#if inv_kpis.length > 0 && inv_dates.length > 0 && inv_inventory_overview.length > 0 && inv_stock_value_by_category.length > 0 && inv_cat_yesterday.length > 0 && inv_cat_7d.length > 0 && inv_cat_30d.length > 0 && inv_trend_7d.length > 0 && inv_trend_30d.length > 0}
  {@const activeKpi = inv_kpis.find(row => row.period === (inputs.period ?? 'yesterday')) ?? inv_kpis[0]}
  {@const activeKpiPct = activeKpi.pct_dari_revenue ?? 0}
  {@const activeKpiRatio = activeKpi.rasio_beli_pakai ?? 0}
  {@const activeKpiCategory = activeKpi.kategori_tertinggi ?? 'produce'}
  
  {@const isYesterday = (inputs.period ?? 'yesterday') === 'yesterday'}
  {@const costState = activeKpiPct <= 32 ? 'safe' : activeKpiPct <= 38 ? 'warn' : 'critical'}
  {@const ratioState = activeKpiRatio === 0 ? (isYesterday ? 'safe' : 'critical') : activeKpiRatio < 0.9 ? 'critical' : activeKpiRatio <= 1.2 ? 'safe' : activeKpiRatio <= 1.5 ? 'warn' : 'critical'}
  {@const indexStatus = costState === 'critical' || ratioState === 'critical' ? 'critical' : costState === 'warn' || ratioState === 'warn' ? 'warn' : 'safe'}
  
  {@const indexSafeCount = [costState, ratioState].filter(s => s === 'safe').length}
  {@const indexWarnCount = [costState, ratioState].filter(s => s === 'warn').length}
  {@const indexCriticalCount = [costState, ratioState].filter(s => s === 'critical').length}

  {@const activeCatData = (inputs.period ?? 'yesterday') === '30d' ? inv_cat_30d : (inputs.period ?? 'yesterday') === '7d' ? inv_cat_7d : inv_cat_yesterday}
  {@const activeTrendData = (inputs.period ?? 'yesterday') === '30d' ? inv_trend_30d : inv_trend_7d}

<div class="inv-page">

  <ButtonGroup name=period>
    <ButtonGroupItem valueLabel="⚡ Kemarin" value="yesterday" default />
    <ButtonGroupItem valueLabel="📊 7 Hari" value="7d" />
    <ButtonGroupItem valueLabel="🔭 30 Hari" value="30d" />
  </ButtonGroup>

  <!-- Executive Summary Cockpit Card -->
  <div class="inv-status-card {indexStatus}" style="margin-top: 10px;">
    <div>
      <div class="inv-status-label">Status Utama · Inventori &amp; Biaya Bahan {(inputs.period ?? 'yesterday') === '30d' ? '30H' : (inputs.period ?? 'yesterday') === '7d' ? '7H' : 'Kemarin'}</div>
      <h2 class="inv-status-title">
        {#if indexStatus === 'safe'}Kesehatan biaya bahan dan belanja terkendali dengan baik. ✅
        {:else if indexStatus === 'warn'}Efisiensi belanja atau biaya bahan memerlukan perhatian. ⚠️
        {:else}Biaya bahan makanan atau over-purchasing masuk area kritis! 🚨{/if}
      </h2>
      <p class="inv-status-copy">
        Kategori dengan biaya tertinggi saat ini <strong>{activeKpiCategory}</strong>. Rata-rata biaya bahan makanan adalah <strong>{activeKpiPct}%</strong> dari revenue, dan rasio beli vs pakai berada di angka <strong>{activeKpiRatio === 0 && isYesterday ? '0.00x (Tidak ada pembelian)' : activeKpiRatio.toFixed(2) + 'x'}</strong>. Ini meneruskan cara baca dari beranda: mulai dari efisiensi belanja dan Food Cost, baru masuk ke akar masalah operasional di bawah (stok berlebih, low stock, supplier).
      </p>
      <div class="inv-status-action">
        <strong>Mulai dari sini:</strong>
        {#if ratioState === 'critical'}cek cabang penimbun stok berlebih di tab <strong>Stok Aktual (Overstock)</strong> untuk menahan PO baru.
        {:else if costState === 'critical'}cek kenaikan harga supplier di tab <strong>Analisis Lanjutan</strong> untuk prioritas negosiasi kontrak.
        {:else}gunakan kategori biaya tertinggi sebagai benchmark, lalu buka <strong>Stok Aktual</strong> hanya jika ada titik low stock aktif.{/if}
      </div>
    </div>
    <div class="inv-status-metrics">
      <div class="inv-status-metric">
        <div class="inv-status-metric-label">📅 Periode Aktif</div>
        <div class="inv-status-metric-value">
          {#if (inputs.period ?? 'yesterday') === '30d'}
            {inv_dates[0].tgl_30d_awal} - {inv_dates[0].tgl_akhir}
          {:else if (inputs.period ?? 'yesterday') === '7d'}
            {inv_dates[0].tgl_7d_awal} - {inv_dates[0].tgl_akhir}
          {:else}
            {inv_dates[0].tgl_akhir}
          {/if}
        </div>
        <div class="inv-status-metric-note">Window analisis pergerakan inventori. Pergerakan riil dicatat untuk mendiagnosis efisiensi modal.</div>
      </div>
      <div class="inv-status-metric">
        <div class="inv-status-metric-label">📦 Kategori Termahal</div>
        <div class="inv-status-metric-value" style="text-transform: capitalize;">{activeKpiCategory}</div>
        <div class="inv-status-metric-note">Kategori bahan baku yang paling banyak menyedot pengeluaran dapur dalam periode aktif ini.</div>
      </div>
    </div>
  </div>

  <!-- Ringkasan 2 Indikator Utama -->
  <div class="inv-summary">
    <div class="inv-summary-head">
      <div class="inv-summary-label">Ringkasan 2 Indikator Utama</div>
      <div class="inv-badges">
        <span class="inv-badge safe">✓ {indexSafeCount} sehat</span>
        <span class="inv-badge warn">! {indexWarnCount} waspada</span>
        <span class="inv-badge critical">x {indexCriticalCount} kritis</span>
      </div>
    </div>
    <div class="inv-list">
      <div class="inv-row {costState}">
        <div class="inv-icon">{costState === 'safe' ? '✅' : costState === 'warn' ? '⚠️' : '🚨'}</div>
        <div><span class="inv-row-title">Biaya Bahan dari Revenue</span> <span class="inv-row-copy">- <span class="inv-row-value">{activeKpiPct}%</span>. Sehat = ≤32%, Waspada = 32-38%, Kritis = di atas 38% (standar industri restoran 28-32%).</span></div>
      </div>
      <div class="inv-row {ratioState}">
        <div class="inv-icon">{ratioState === 'safe' ? '✅' : ratioState === 'warn' ? '⚠️' : '🚨'}</div>
        <div><span class="inv-row-title">Rasio Beli vs Pakai</span> <span class="inv-row-copy">- <span class="inv-row-value">{activeKpiRatio === 0 && isYesterday ? '0.00x (Tidak ada pembelian)' : activeKpiRatio.toFixed(2) + 'x'}</span>. Sehat = 0.9 - 1.2x (belanja seimbang), Waspada = 1.2 - 1.5x (penimbunan awal), Kritis = di atas 1.5x (over-purchasing) atau di bawah 0.9x.</span></div>
      </div>
    </div>
  </div>

  <!-- Section 1: Efisiensi Belanja & Pemakaian Bahan -->
  <div class="section-card" style="margin-top: 16px;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">📊 Komposisi &amp; Efisiensi Biaya Bahan ({(inputs.period ?? 'yesterday') === '30d' ? '30 Hari' : (inputs.period ?? 'yesterday') === '7d' ? '7 Hari' : 'Kemarin'})</div>
        <h3 class="section-title">Bandingkan total pemakaian bahan baku dengan total pembelian baru per kategori</h3>
        <p class="section-copy">Gunakan bagian ini untuk memantau apakah kita melakukan pembelian berlebih pada kategori tertentu (seperti produce, meat, dry goods) dibandingkan kebutuhan pemakaian riil.</p>
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-top: 16px;">
      <!-- Chart 1: Pemakaian vs Pembelian -->
      <div>
        <BarChart 
          data={activeCatData} 
          x="category" 
          y={["biaya_pakai", "biaya_beli"]} 
          type="grouped" 
          title="Pemakaian vs Pembelian per Kategori" 
          xAxisTitle="Kategori" 
          yAxisTitle="Biaya (Rp)" 
          yFmt="#,##0" 
          colorPalette={['#2563eb', '#93c5fd']}
        />
        <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 8px; line-height: 1.45;">
          *Bandingkan pengeluaran belanja riil (kanan) dengan nilai bahan terpakai (kiri) dalam periode aktif.
        </div>
      </div>

      <!-- Chart 2: Tren Harga atau Komposisi Nilai Stok -->
      <div>
        {#if (inputs.period ?? 'yesterday') === 'yesterday'}
          <BarChart 
            data={inv_stock_value_by_category} 
            x="category" 
            y="stock_value"
            title="Nilai Stok Aktual per Kategori" 
            yFmt="#,##0" 
            xAxisTitle="Kategori" 
            yAxisTitle="Nilai Stok (Rp)" 
            colorPalette={['#2563eb']}
          />
          <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 8px; line-height: 1.45;">
            *Nilai total modal yang terikat sebagai stok fisik pada penutupan hari kemarin.
          </div>
        {:else}
          <LineChart 
            data={activeTrendData} 
            x="txn_date" 
            y="avg_harga" 
            series="category" 
            title="Tren Rata-rata Harga Bahan Baku (Rp)" 
            yFmt="#,##0" 
            xAxisTitle="Tanggal" 
            yAxisTitle="Avg Harga (Rp)" 
            colorPalette={['#2563eb', '#475569', '#818cf8', '#0d9488', '#64748b', '#94a3b8']}
          />
          <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 8px; line-height: 1.45;">
            *Grafik pergerakan harga rata-rata bahan baku per kategori dari transaksi pembelian aktual.
          </div>
        {/if}
      </div>
    </div>
  </div>

  {#if (inputs.period ?? 'yesterday') !== 'yesterday'}
  <!-- Section 2: Komposisi & Nilai Stok Aktual -->
  <div class="section-card" style="margin-top: 16px;">
    <div class="section-head">
      <div>
        <div class="section-eyebrow">📦 Komposisi Stok Snapshot</div>
        <h3 class="section-title">Kategori mana yang paling banyak mengikat modal?</h3>
        <p class="section-copy">Gunakan bagian ini untuk membedakan bahan inti yang wajar bernilai besar dari kategori yang mulai menumpuk.</p>
      </div>
    </div>
    <div style="margin-top: 16px;">
      <BarChart 
        data={inv_stock_value_by_category} 
        x="category" 
        y="stock_value"
        title="Nilai Stok Aktual per Kategori" 
        yFmt="#,##0" 
        xAxisTitle="Kategori" 
        yAxisTitle="Nilai Stok (Rp)" 
        colorPalette={['#2563eb']}
      />
      <div style="font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 8px; line-height: 1.45;">
        *Nilai total modal yang terikat sebagai stok fisik berdasarkan pencatatan gudang aktual.
      </div>
    </div>
  </div>
  {/if}

  <!-- Panduan Konseptual (Collapsible) -->
  <details class="guide-acc" style="margin-top:12px;">
    <summary>📘 Kenapa Biaya Bahan dan Rasio Beli/Pakai jadi angka utama?</summary>
    <div class="guide-body">
      <p style="margin-top: 4px; margin-bottom: 16px; font-weight: 500; color: var(--color-text-secondary);">
        Kedua indikator ini mengukur kesehatan finansial di modul inventori sebelum Anda mengaudit anomali stok fisik di outlet. Pilihan periode disinkronkan dengan beranda agar alur pembacaan data berjalan konsisten.
      </p>
      <div class="guide-grid">
        <div class="guide-card food-cost">
          <div class="guide-card-icon">💸</div>
          <div class="guide-card-content">
            <div class="guide-card-label">Biaya Bahan</div>
            <h4 class="guide-card-title">Efisiensi Bahan Baku</h4>
            <p class="guide-card-desc">Mengukur porsi penjualan yang dihabiskan untuk membeli bahan makanan. Target ideal restoran berkisar <strong>28-32%</strong>. Angka tinggi berarti ada pemborosan di porsi atau harga beli naik.</p>
          </div>
        </div>
        <div class="guide-card purchase-ratio">
          <div class="guide-card-icon">⚖️</div>
          <div class="guide-card-content">
            <div class="guide-card-label">Rasio Beli/Pakai</div>
            <h4 class="guide-card-title">Disiplin Pengadaan</h4>
            <p class="guide-card-desc">Membandingkan total belanja dengan pemakaian. Nilai di atas <strong>1.2x</strong> berarti menimbun barang (over-purchasing), di bawah <strong>0.9x</strong> berarti membiarkan stok lama terkuras kritis.</p>
          </div>
        </div>
        <div class="guide-card next-steps">
          <div class="guide-card-icon">🚀</div>
          <div class="guide-card-content">
            <div class="guide-card-label">Lanjutannya</div>
            <h4 class="guide-card-title">Masuk ke Operasional</h4>
            <p class="guide-card-desc">Jika biaya bahan tinggi atau belanja tidak seimbang, periksa ringkasan stok aktual di bawah untuk melihat item kritis yang perlu segera dibeli atau ditransfer.</p>
          </div>
        </div>
      </div>
    </div>
  </details>

  <!-- Collapsible Strategic Diagnosis (Kondisi Stok Aktual & Aksi Taktis) -->
  <details class="acc-strategic" style="margin-top:14px;" open>
    <summary>📦 Ringkasan Operasional Stok Aktual &amp; Rekomendasi Aksi</summary>
    <div class="acc-body">
      <div class="strategic-stack" style="margin-top:0;">
        <div class="strategic-header">
          <div class="strategic-eyebrow">Kondisi Stok Aktual</div>
          <h3 class="strategic-title" style="margin-top:0;">Peta Status Stok Cabang &amp; Rekomendasi Taktis Hari Ini</h3>
          <p class="strategic-copy">Daftar kebutuhan pengadaan dan peluang efisiensi modal kerja melalui transfer stok antar cabang. Bagian ini menampilkan data riil/aktual saat ini dan tidak dipengaruhi oleh selektor tanggal di atas.</p>
        </div>

        <div class="ops-grid" style="margin-top:16px;">
          <div class="ops-card critical">
            <span class="ops-card-label">🚨 Kritis &amp; Reorder</span>
            <span class="ops-card-value">{inv_latest_reorder_agg[0].critical_reorder_count ?? 0} Item</span>
            <span class="ops-card-desc">Bahan baku dengan sisa stok di bawah 3 hari. Perlu segera dibeli atau ditransfer untuk mencegah menu kosong.</span>
          </div>
          <div class="ops-card warn">
            <span class="ops-card-label">📦 Overstock Aktual</span>
            <span class="ops-card-value">{inv_latest_overstock_agg[0].total_overstock_items ?? 0} Item</span>
            <span class="ops-card-desc">Bahan baku menumpuk di atas 14 hari pemakaian. Menahan modal kerja sebesar <strong>Rp {((inv_latest_overstock_agg[0].total_idle_value ?? 0)/1000000).toFixed(1)}jt</strong>.</span>
          </div>
          <div class="ops-card info">
            <span class="ops-card-label">🔄 Peluang Transfer Stok</span>
            <span class="ops-card-value">{inv_latest_transfers.length} Rekomendasi</span>
            <span class="ops-card-desc">Bahan yang sama overstock di satu cabang tapi kritis di cabang lain. Solusi cegah PO baru.</span>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 18px; margin-top: 14px;">
          <!-- Left side: Critical Items list -->
          <div class="section-card" style="padding: 16px; border-radius: 14px; background: rgba(255,255,255,0.4);">
            <div class="section-head" style="margin-bottom: 10px;">
              <div>
                <div class="section-eyebrow" style="font-size: 8px;">🛒 KEBUTUHAN REORDER SEGERA</div>
                <h4 class="section-title" style="font-size: 0.95rem; margin: 0;">Bahan Rawan Habis &lt; 3 Hari</h4>
              </div>
            </div>
            {#if inv_latest_reorder.filter(r => r.days_remaining < 3).length > 0}
              <DataTable data={inv_latest_reorder.filter(r => r.days_remaining < 3)} rows=5 search=false>
                <Column id="item_name" title="Bahan" />
                <Column id="branch_name" title="Cabang" />
                <Column id="avg_daily_usage" title="Pakai/Hari" fmt="#,##0.0" />
                <Column id="days_remaining" title="Sisa Hari" fmt="0.0" />
              </DataTable>
              <div class="chart-insight" style="margin-top: 10px;">📌 Item dalam daftar ini berada di bawah batas aman sisa hari (&lt; 3 hari) dan memerlukan reorder segera untuk menghindari kekosongan stok.</div>
            {:else}
              <div style="font-size: 0.82rem; color: var(--color-text-secondary); padding: 20px; text-align: center; border: 1px dashed var(--color-border-tertiary); border-radius: 10px;">
                ✅ Semua stok cabang aman di atas 3 hari.
              </div>
            {/if}
          </div>

          <!-- Right side: Transfer Recommendations -->
          <div class="section-card" style="padding: 16px; border-radius: 14px; background: rgba(255,255,255,0.4);">
            <div class="section-head" style="margin-bottom: 10px;">
              <div>
                <div class="section-eyebrow" style="font-size: 8px;">🔄 PEMINDAHAN STOK INTERNAL</div>
                <h4 class="section-title" style="font-size: 0.95rem; margin: 0;">Rekomendasi Transfer Antar Cabang</h4>
              </div>
            </div>
            {#if inv_latest_transfers.length > 0}
              <DataTable data={inv_latest_transfers} rows=5 search=false>
                <Column id="item_name" title="Bahan" />
                <Column id="branch_source" title="Dari" />
                <Column id="branch_need" title="Ke" />
                <Column id="source_days" title="Sisa Hari" fmt="0.0" />
              </DataTable>
              <div class="chart-insight" style="margin-top: 10px;">📌 Prioritaskan transfer stok dari cabang penyuplai (overstock) ke cabang tujuan sebelum mengajukan Purchase Order (PO) baru ke supplier.</div>
            {:else}
              <div style="font-size: 0.82rem; color: var(--color-text-secondary); padding: 20px; text-align: center; border: 1px dashed var(--color-border-tertiary); border-radius: 10px;">
                👍 Tidak ada peluang transfer stok yang cocok saat ini.
              </div>
            {/if}
          </div>
        </div>

      </div>
    </div>
  </details>

</div>
{/if}
